# Deployment via foundry accounts (MailboxCRE / FeeSharesMinter deploy scripts)
ACCOUNT_NAME=

# RPC endpoints for foundry (replace with your own, public or paid)
RPC_MAINNET=https://eth.llamarpc.com
RPC_OPTIMISM=https://optimism.llamarpc.com
RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
RPC_POLYGON=https://polygon.llamarpc.com
RPC_ARBITRUM=https://arbitrum.llamarpc.com
RPC_BASE=https://base.llamarpc.com
RPC_GNOSIS=https://rpc.ankr.com/gnosis
RPC_BNB=https://binance.llamarpc.com
RPC_SCROLL=https://rpc.scroll.io

# Tenderly Virtual TestNet (mainnet fork) — paste the URL Tenderly gave you
RPC_TENDERLY_DEVNET=

# Etherscan v2 API key
ETHERSCAN_API_KEY=

# RPC endpoints consumed by the CRE automation workflows (workflows/project.yaml,
# ${RPC_URL_<CHAIN>}). Replace with your own (public or paid).
RPC_URL_ETHEREUM=https://eth.llamarpc.com
RPC_URL_POLYGON=https://polygon.llamarpc.com
RPC_URL_OPTIMISM=https://optimism.llamarpc.com
RPC_URL_ARBITRUM=https://arbitrum.llamarpc.com
RPC_URL_BASE=https://base.llamarpc.com
RPC_URL_BNB=https://binance.llamarpc.com
RPC_URL_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
