# Enforce that every installed package version has been available on the
# registry for at least 30 days. Requires npm >= 11 (`min-release-age` was
# added there). Value is in days.
min-release-age=30

# All installs must pin exact versions (no ^ / ~).
save-exact=true

# Warn (don't fail) on engine mismatch so installs work on the npm bundled with
# Node 22 (npm 10); npm 11 is still recommended for `min-release-age` to apply.
engine-strict=false
package-lock=true
