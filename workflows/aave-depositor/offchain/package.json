{
  "name": "aave-depositor-workflow",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "simulate:ethereum": "cre workflow simulate ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-ethereum-production-settings --non-interactive --trigger-index=0",
    "deploy:ethereum": "cre workflow deploy ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-ethereum-production-settings",
    "deploy:ethereum:unsigned": "cre workflow deploy ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-ethereum-production-settings --unsigned",
    "activate:ethereum:unsigned": "cre workflow activate ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-ethereum-production-settings --unsigned --yes",
    "pause:ethereum:unsigned": "cre workflow pause ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-ethereum-production-settings --unsigned --yes",
    "delete:ethereum:unsigned": "cre workflow delete ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-ethereum-production-settings --unsigned --yes",
    "simulate:arbitrum": "cre workflow simulate ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-arbitrum-production-settings --non-interactive --trigger-index=0",
