    "deploy:arbitrum:unsigned": "cre workflow deploy ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-arbitrum-production-settings --unsigned",
    "activate:arbitrum:unsigned": "cre workflow activate ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-arbitrum-production-settings --unsigned --yes",
    "pause:arbitrum:unsigned": "cre workflow pause ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-arbitrum-production-settings --unsigned --yes",
    "delete:arbitrum:unsigned": "cre workflow delete ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-arbitrum-production-settings --unsigned --yes",
    "simulate:base": "cre workflow simulate ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-base-production-settings --non-interactive --trigger-index=0",
    "deploy:base": "cre workflow deploy ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-base-production-settings",
    "deploy:base:unsigned": "cre workflow deploy ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-base-production-settings --unsigned",
    "activate:base:unsigned": "cre workflow activate ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-base-production-settings --unsigned --yes",
    "pause:base:unsigned": "cre workflow pause ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-base-production-settings --unsigned --yes",
    "delete:base:unsigned": "cre workflow delete ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-base-production-settings --unsigned --yes",
    "simulate:optimism": "cre workflow simulate ./aave-depositor/offchain --project-root=../.. --env=../../../.env --target=aave-depositor-optimism-production-settings --non-interactive --trigger-index=0",
