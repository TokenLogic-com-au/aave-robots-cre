{
  "name": "voting-chain-robot-workflow",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "simulate:production": "cre workflow simulate ./voting-chain-robot/offchain --project-root=../.. --env=../../../.env --target=voting-chain-robot-production-settings --non-interactive --trigger-index=0",
    "deploy:production": "cre workflow deploy ./voting-chain-robot/offchain --project-root=../.. --env=../../../.env --target=voting-chain-robot-production-settings",
    "deploy:production:unsigned": "cre workflow deploy ./voting-chain-robot/offchain --project-root=../.. --env=../../../.env --target=voting-chain-robot-production-settings --unsigned",
    "activate:production:unsigned": "cre workflow activate ./voting-chain-robot/offchain --project-root=../.. --env=../../../.env --target=voting-chain-robot-production-settings --unsigned --yes",
    "pause:production:unsigned": "cre workflow pause ./voting-chain-robot/offchain --project-root=../.. --env=../../../.env --target=voting-chain-robot-production-settings --unsigned --yes",
    "delete:production:unsigned": "cre workflow delete ./voting-chain-robot/offchain --project-root=../.. --env=../../../.env --target=voting-chain-robot-production-settings --unsigned --yes"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@chainlink/cre-sdk": "1.6.0",
    "viem": "2.48.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "npm": ">=11"
  }
}
