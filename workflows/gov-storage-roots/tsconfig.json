{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "main.ts",
    "handlers.ts",
    "processStorageRoots.ts",
    "proofs.ts",
    "rpc.ts",
    "types.ts",
    "workflow.test.ts"
  ]
}
