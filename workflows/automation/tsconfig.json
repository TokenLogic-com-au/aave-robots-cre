{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "main.ts",
    "handlers.ts",
    "processAutomation.ts",
    "address.ts",
    "gas.ts",
    "types.ts",
    "roots/**/*.ts"
  ]
}
